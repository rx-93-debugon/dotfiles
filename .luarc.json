{
  "$schema": "https://raw.githubusercontent.com/sumneko/vscode-lua/master/setting/schema.json",
  "runtime": {
    "version": "LuaJIT"
  },
  "workspace": {
    "checkThirdParty": false,
    "library": [
      "/opt/nvim/share/nvim/runtime",
      "/usr/share/nvim/runtime",
      "/opt/homebrew/share/nvim/runtime",
      "${3rd}/luv/library"
    ]
  },
  "diagnostics": {
    "globals": [
      "vim",
      "wezterm"
    ]
  }
}
