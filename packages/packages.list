# ==============================================================================
# Package Definition List
# ==============================================================================
# Format:
#   <logical_name>    <homebrew_pkg>         <apt_pkg>
#
# Use '-' if the package is not installed via package manager on that platform.
# ==============================================================================

# Shell & Completion
bash                  bash                   -
bash-completion       bash-completion@2      bash-completion

# Common CLI tools
tmux                  tmux                   tmux
git                   git                    git
gh                    gh                     gh
curl                  curl                   curl
fzf                   fzf                    fzf
ripgrep               ripgrep                ripgrep
fd                    fd                     fd-find

# Ubuntu build tools
build-essential       -                      build-essential
gcc                   -                      gcc
g++                   -                      g++
make                  -                      make

# Development tools
git-delta             git-delta              git-delta
lazygit               lazygit                lazygit
neovim                neovim                 neovim
